# shared
INTERNAL_TOKEN=dev-internal-token-change-me
DATABASE_URL=postgresql://logistream:logistream@localhost:5432/logistream

# orchestrator (Python) -> LiteLLM proxy -> OpenRouter
OPENROUTER_API_KEY=
LITELLM_MASTER_KEY=sk-logistream-dev
LLM_BASE_URL=http://localhost:4000/v1   # the LiteLLM proxy; see litellm_config.yaml
# Internal names, NOT vendor slugs. litellm_config.yaml maps them to real models
# and fails over to a backup when the free tier returns 429.
LLM_MODEL_EVALUATOR=logistream-evaluator
LLM_MODEL_TUTOR=logistream-tutor
LLM_THINK=0                         # 1 = let local qwen3 "think" (80 s vs 5 s per short turn)
LLM_TIMEOUT_S=150                   # a cold local model load after a VLM swap took ~76 s
FLAG_CONFIDENCE_THRESHOLD=0.6
MAX_REGENERATIONS=2
DOMAIN_URL=http://localhost:8080
ORCHESTRATOR_PORT=8001
ORCHESTRATOR_BIND=0.0.0.0

# screen observer: LOCAL Ollama only (any non-local host is refused at startup)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_VLM_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT_S=60
# how the LiteLLM container reaches the same Ollama for the text model
OLLAMA_API_BASE_FOR_LITELLM=http://host.docker.internal:11434

# Rust intel sidecar (GRU + booster); optional, 2 s timeout, rules fallback
INTEL_URL=http://127.0.0.1:8003
INTEL_PORT=8003
INTEL_TIMEOUT_S=2.0
INTEL_ENABLED=1

# domain (Java)
# LOCAL runs student python in a subprocess here: free, offline, real errors.
# JUDGE0 swaps in the hosted Judge0 CE client (needs a paid RapidAPI key).
EXECUTOR_MODE=LOCAL
EXECUTOR_PYTHON=python
# LOCAL is NOT a security sandbox: student code runs with this service's
# privileges. Never expose it publicly. To lock the stack to loopback, set all
# three *_BIND=127.0.0.1 AND change every localhost URL here to 127.0.0.1 --
# on Windows a localhost call to a v4-only listener first waits ~2s on ::1.
DOMAIN_BIND=0.0.0.0

JUDGE0_URL=https://judge0-ce.p.rapidapi.com     # only used when EXECUTOR_MODE=JUDGE0
JUDGE0_RAPIDAPI_KEY=                             # from your RapidAPI dashboard
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com    # confirm against the RapidAPI listing
JUDGE0_PYTHON_LANGUAGE_ID=71                     # verify with GET /languages
JUDGE0_POLL_INTERVAL_MS=1000
JUDGE0_MAX_POLLS=15

# gateway (Rust)
GATEWAY_PORT=8000
GATEWAY_BIND=0.0.0.0
# PUBLIC DEMO (demo/DEPLOY_VERCEL.md): set a passcode before opening a tunnel.
# Empty = no passcode (localhost only). Never commit the real one.
DEMO_PASSCODE=
RUN_RATE_LIMIT_PER_MIN=12
OBSERVE_RATE_LIMIT_PER_MIN=12
ORCHESTRATOR_URL=http://localhost:8001
DOMAIN_URL_FOR_GATEWAY=http://localhost:8080
DEMO_USER_ID=demo-user
CORS_ORIGIN=http://localhost:3000     # comma-separated; add https://<your-app>.vercel.app

# web
NEXT_PUBLIC_API_BASE=http://localhost:8000   # on Vercel: the cloudflared tunnel URL
